# ── Embedding（FAISS 向量检索）────────────────────────────────────────────────────
# 推荐 text-embedding-3-large（3072 维，召回精度高），支持 OpenAI 官方或兼容代理
# 也可替换为其他 embedding 模型，但需删除 faiss_index 目录重建索引
OPENAI_API_KEY=sk-...

# ── LLM（语义分析 + 词汇生成，任意 OpenAI 兼容接口均可）─────────────────────────
# 按需取消注释，填入对应 Key；同时修改 backend/core/semantic.py 和
# backend/core/generate_vocabulary.py 中的 base_url 与 model 字段

# DeepSeek（默认）
DEEPSEEK_API_KEY=sk-...

# 阿里云百炼 / Qwen
# DASHSCOPE_API_KEY=sk-...

# 智谱 GLM
# ZHIPUAI_API_KEY=...

# 月之暗面 Kimi
# MOONSHOT_API_KEY=sk-...

# OpenAI（直接使用 OPENAI_API_KEY，无需额外变量）
